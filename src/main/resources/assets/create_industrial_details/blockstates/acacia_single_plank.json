{
  "multipart": [
    {
      "when": {
        "axis": "x",
        "left": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/single_plank/acacia_single_plank_left"
      }
    },
    {
      "when": {
        "axis": "x",
        "center": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/single_plank/acacia_single_plank_center"
      }
    },
    {
      "when": {
        "axis": "x",
        "right": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/single_plank/acacia_single_plank_right"
      }
    },
    {
      "when": {
        "axis": "z",
        "left": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/single_plank/acacia_single_plank_left",
        "y": 270
      }
    },
    {
      "when": {
        "axis": "z",
        "center": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/single_plank/acacia_single_plank_center",
        "y": 270
      }
    },
    {
      "when": {
        "axis": "z",
        "right": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/single_plank/acacia_single_plank_right",
        "y": 270
      }
    }
  ]
}
