{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "create_industrial_details:block/riveted_steel/service_trench_casing",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "create_industrial_details:block/riveted_steel/service_trench_casing",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "create_industrial_details:block/riveted_steel/service_trench_casing",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "create_industrial_details:block/riveted_steel/service_trench_casing",
        "y": 270
      }
    },
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "create_industrial_details:block/riveted_steel/service_trench_glass_window",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "axis": "y"
      },
      "apply": {
        "model": "create_industrial_details:block/riveted_steel/service_trench_glass_window"
      }
    },
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "create_industrial_details:block/riveted_steel/service_trench_glass_window",
        "x": 90
      }
    }
  ]
}
