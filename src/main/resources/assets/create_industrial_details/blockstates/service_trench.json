{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "open": "false"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_casing",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east",
        "open": "false"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_casing",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "open": "false"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_casing",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "open": "false"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_casing",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "open": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_open",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east",
        "open": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_open",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "open": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_open",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "open": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_open",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north|south",
        "cap_negative": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_end_cap",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "north|south",
        "cap_positive": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_end_cap",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "east|west",
        "cap_negative": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_end_cap",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "east|west",
        "cap_positive": "true"
      },
      "apply": {
        "model": "create_industrial_details:block/industrial_steel/service_trench_end_cap",
        "y": 90
      }
    }
  ]
}
